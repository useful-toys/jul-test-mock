# O mvnw e um script sh e precisa de LF; o mvnw.cmd e um script do Windows e precisa de CRLF.
# Sem isso, o autocrlf do Windows grava o mvnw com CRLF no disco e o sh quebra.
mvnw text eol=lf
*.cmd text eol=crlf
# O Maven le uma opcao por linha do maven.config; CRLF deixaria um \r colado na opcao.
.mvn/maven.config text eol=lf
