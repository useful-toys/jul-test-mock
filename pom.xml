<!--
  To update the Maven wrapper (script-only mode, without maven-wrapper.jar):
  1. Run: sh mvnw wrapper:wrapper -Dtype=only-script -Dmaven=X
     (the plugin version comes from maven-wrapper-plugin.version).
  2. Recompute distributionSha256Sum in .mvn/wrapper/maven-wrapper.properties:
     download apache-maven-X-bin.zip from Maven Central, check it against the
     official .sha512 and then compute its SHA-256 (Get-FileHash -Algorithm
     SHA256, or sha256sum). The wrapper scripts refuse a different hash.
  3. If X leaves the range [3.10.0,3.11), adjust requireMavenVersion in the
     enforcer configuration below.
  -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.usefultoys</groupId>
    <artifactId>jul-test-mock</artifactId>
    <version>0.0.3-SNAPSHOT</version>
    <name>JUL Test Mock Implementation</name>


    <description>A comprehensive mock implementation of the JUL (Java Util Logging) logging framework designed specifically for unit testing.</description>
    <url>https://github.com/useful-toys/jul-test-mock</url>
    <inceptionYear>2025</inceptionYear>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Daniel Felix Ferber</name>
            <email>danielferber@gmail.com</email>
            <organization>None</organization>
            <organizationUrl>https://github.com/danielferber</organizationUrl>
            <roles>
                <role>Lead Developer</role>
            </roles>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git@github.com/useful-toys/jul-test-mock.git</connection>
        <developerConnection>scm:git:git@github.com/useful-toys/jul-test-mock.git</developerConnection>
        <url>git@github.com/useful-toys/jul-test-mock.git</url>
    </scm>


    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <lombok.version>1.18.42</lombok.version>
        <!-- Keep JUnit on 5.x: JUnit 6 requires Java 17, but this library generates Java 8 bytecode and junit-jupiter-api
             is a compile dependency. The enforceBytecodeVersion rule rejects the upgrade. -->
        <junit5.version>5.14.1</junit5.version>
        <jacoco-maven-plugin.version>0.8.16</jacoco-maven-plugin.version>
        <versions-maven-plugin.version>2.23.0</versions-maven-plugin.version>
        <maven-surefire-plugin.version>3.6.1</maven-surefire-plugin.version>
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
        <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
        <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
        <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
        <checkstyle.version>10.26.1</checkstyle.version>
        <maven-pmd-plugin.version>3.28.0</maven-pmd-plugin.version>
        <spotbugs-maven-plugin.version>4.10.5.0</spotbugs-maven-plugin.version>
        <findsecbugs-plugin.version>1.14.0</findsecbugs-plugin.version>
        <error-prone.version>2.52.0</error-prone.version>
        <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
        <maven-enforcer-plugin.version>3.7.0</maven-enforcer-plugin.version>
        <extra-enforcer-rules.version>1.12.1</extra-enforcer-rules.version>
        <central-publishing-maven-plugin.version>0.12.0</central-publishing-maven-plugin.version>

        <!-- Default lifecycle plugins: pinned so the build does not depend on the versions bundled with Maven. -->
        <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
        <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <maven-install-plugin.version>3.2.0</maven-install-plugin.version>
        <maven-deploy-plugin.version>3.2.0</maven-deploy-plugin.version>
        <maven-site-plugin.version>3.22.0</maven-site-plugin.version>
        <maven-help-plugin.version>3.5.2</maven-help-plugin.version>
        <maven-wrapper-plugin.version>3.3.4</maven-wrapper-plugin.version>
    </properties>


    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit5.version}</version>
            <scope>compile</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Default lifecycle plugins (clean, resources, jar, install, deploy, site) -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>${maven-clean-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>${maven-install-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>${maven-deploy-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-site-plugin</artifactId>
                    <version>${maven-site-plugin.version}</version>
                </plugin>
                <!-- Utility plugins run from the command line or CI: help:evaluate, wrapper:wrapper -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-help-plugin</artifactId>
                    <version>${maven-help-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-wrapper-plugin</artifactId>
                    <version>${maven-wrapper-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>versions-maven-plugin</artifactId>
                    <version>${versions-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <!-- dependency:analyze-only (static analysis job) reports unused declared and
                         used undeclared dependencies; informative, never fails the build. -->
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${maven-dependency-plugin.version}</version>
                    <configuration>
                        <failOnWarning>false</failOnWarning>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <!-- Configures compiler to create Java 8 compatible classes, checked by Error Prone.
                     Error Prone runs inside javac and needs JDK 21+ to build (enforced below).
                     javac is forked so the JDK internals it needs are opened only for javac (-J flags):
                     a .mvn/jvm.config would break Maven on the JDK 8 compatibility test jobs. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <release>8</release>
                    <fork>true</fork>
                    <compilerArgs>
                        <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED</arg>
                        <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED</arg>
                        <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED</arg>
                        <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED</arg>
                        <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED</arg>
                        <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED</arg>
                        <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
                        <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
                        <!-- Enable all warnings except 'options' (which warns about obsolete source/target values) -->
                        <arg>-Xlint:all</arg>
                        <arg>-Xlint:-options</arg>
                        <arg>-XDcompilePolicy=simple</arg>
                        <arg>--should-stop=ifError=FLOW</arg>
                        <arg>-Xplugin:ErrorProne -XepDisableWarningsInGeneratedCode</arg>
                        <!-- Needed when building with JDK 21: https://github.com/google/error-prone/issues/5426 -->
                        <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
                    </compilerArgs>
                    <!-- Setting these paths stops javac from discovering processors on the classpath,
                         so Lombok must be listed here too. -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>com.google.errorprone</groupId>
                            <artifactId>error_prone_core</artifactId>
                            <version>${error-prone.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- Build validations (Maven/JDK versions, dependency and plugin hygiene). Disabled as a whole
                     by -Denforcer.skip=true, which the JDK compatibility jobs rely on. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <dependencies>
                    <!-- MojoHaus rules (e.g. banDuplicateClasses, enforceBytecodeVersion). -->
                    <dependency>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>extra-enforcer-rules</artifactId>
                        <version>${extra-enforcer-rules.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>enforce-build</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[3.10.0,3.11)</version>
                                    <message>Build requires Maven 3.10.x (3.10.0 or later). Use the Maven Wrapper: sh mvnw (or mvnw.cmd).</message>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[21,22)</version>
                                    <message>Build requires JDK 21 (Error Prone needs it); the library still targets Java 8. Compatibility tests on other JDKs must pass -Denforcer.skip=true.</message>
                                </requireJavaVersion>
                                <banDuplicateClasses>
                                    <findAllDuplicates>true</findAllDuplicates>
                                    <ignoreWhenIdentical>true</ignoreWhenIdentical>
                                    <ignoreClasses>
                                        <ignoreClass>module-info</ignoreClass>
                                        <ignoreClass>META-INF/versions/**</ignoreClass>
                                    </ignoreClasses>
                                    <message>Duplicate classes found on the classpath (same class in more than one dependency with different content). Run 'sh mvnw dependency:tree' to locate them and exclude or align the conflicting artifacts.</message>
                                </banDuplicateClasses>
                                <enforceBytecodeVersion>
                                    <maxJdkVersion>1.8</maxJdkVersion>
                                    <ignoredScopes>
                                        <ignoredScope>test</ignoredScope>
                                        <ignoredScope>provided</ignoredScope>
                                    </ignoredScopes>
                                    <ignoreClasses>
                                        <ignoreClass>module-info</ignoreClass>
                                    </ignoreClasses>
                                    <message>A compile/runtime dependency contains bytecode newer than Java 8, but this library targets Java 8. Pick a version of that dependency that still supports Java 8, e.g. JUnit 5.x, since JUnit 6 requires Java 17 (test and provided scopes are not checked).</message>
                                </enforceBytecodeVersion>
                                <banDynamicVersions>
                                    <allowRanges>false</allowRanges>
                                    <allowLatest>false</allowLatest>
                                    <allowRelease>false</allowRelease>
                                    <allowSnapshots>true</allowSnapshots>
                                    <message>Dynamic dependency versions (ranges, LATEST, RELEASE) make the build non-reproducible. Declare a fixed version, preferably in a property.</message>
                                </banDynamicVersions>
                                <requirePluginVersions>
                                    <banLatest>true</banLatest>
                                    <banRelease>true</banRelease>
                                    <banSnapshots>true</banSnapshots>
                                    <message>Every plugin must have an explicit, fixed release version (no LATEST, RELEASE or SNAPSHOT). Declare it in pom.xml, preferably through a property.</message>
                                </requirePluginVersions>
                                <dependencyConvergence>
                                    <message>Transitive dependencies converge to different versions. Add an exclusion or pin the version in dependencyManagement; see 'sh mvnw dependency:tree'.</message>
                                </dependencyConvergence>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>

        <!-- Static Analysis Profile - runs static analyzers and writes SARIF reports to target/ (informative, never fails the build).
             Activate with: mvn clean verify -P static-analysis -->
        <profile>
            <id>static-analysis</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-checkstyle-plugin</artifactId>
                        <version>${maven-checkstyle-plugin.version}</version>
                        <dependencies>
                            <dependency>
                                <groupId>com.puppycrawl.tools</groupId>
                                <artifactId>checkstyle</artifactId>
                                <version>${checkstyle.version}</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <configLocation>${project.basedir}/checkstyle.xml</configLocation>
                            <outputFileFormat>sarif</outputFileFormat>
                            <outputFile>${project.build.directory}/checkstyle-result.sarif</outputFile>
                            <includeTestSourceDirectory>true</includeTestSourceDirectory>
                            <failOnViolation>false</failOnViolation>
                            <failsOnError>false</failsOnError>
                            <consoleOutput>false</consoleOutput>
                        </configuration>
                        <executions>
                            <execution>
                                <id>checkstyle-sarif</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>checkstyle</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-pmd-plugin</artifactId>
                        <version>${maven-pmd-plugin.version}</version>
                        <configuration>
                            <rulesets>
                                <ruleset>${project.basedir}/pmd-ruleset.xml</ruleset>
                            </rulesets>
                            <!-- maven-pmd-plugin has no built-in 'sarif' format; use PMD's renderer class. -->
                            <format>net.sourceforge.pmd.renderers.SarifRenderer</format>
                            <includeTests>true</includeTests>
                            <failOnViolation>false</failOnViolation>
                            <printFailingErrors>false</printFailingErrors>
                        </configuration>
                        <executions>
                            <execution>
                                <id>pmd-sarif</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>pmd</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs-maven-plugin</artifactId>
                        <version>${spotbugs-maven-plugin.version}</version>
                        <configuration>
                            <effort>Max</effort>
                            <threshold>Medium</threshold>
                            <includeTests>true</includeTests>
                            <excludeFilterFile>spotbugs-exclude.xml</excludeFilterFile>
                            <failOnError>false</failOnError>
                            <sarifOutput>true</sarifOutput>
                            <plugins>
                                <plugin>
                                    <groupId>com.h3xstream.findsecbugs</groupId>
                                    <artifactId>findsecbugs-plugin</artifactId>
                                    <version>${findsecbugs-plugin.version}</version>
                                </plugin>
                            </plugins>
                        </configuration>
                        <executions>
                            <execution>
                                <id>spotbugs-sarif</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>spotbugs</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Javadoc Validation Profile - validates Javadoc syntax when explicitly requested.
             Activate with: mvn clean verify -P javadoc-validation -->
        <profile>
            <id>javadoc-validation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>${maven-javadoc-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>validate-javadoc</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>javadoc</goal>
                                </goals>
                                <configuration>
                                    <!-- Fails the build if Javadoc generation fails. -->
                                    <failOnError>true</failOnError>
                                    <!-- Matches compiler release 8 sources to avoid doclint differences. -->
                                    <source>8</source>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Release Profile - creates source and javadoc artifacts, signs artifacts and deploys to Maven Central. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>${maven-source-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>${maven-javadoc-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven-gpg-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <!-- Publishing preconditions. Added to the enforcer plugin declared in the main build, so
                             -Denforcer.skip=true disables these rules too. -->
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <version>${maven-enforcer-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>enforce-release</id>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <requireReleaseVersion>
                                            <message>The project version must be a release version, but it is a SNAPSHOT. Set the release version (e.g. 'sh mvnw versions:set -DnewVersion=X.Y.Z') or run the release from a release tag.</message>
                                        </requireReleaseVersion>
                                        <requireReleaseDeps>
                                            <searchTransitive>true</searchTransitive>
                                            <failWhenParentIsSnapshot>true</failWhenParentIsSnapshot>
                                            <message>A SNAPSHOT dependency (direct or transitive) or SNAPSHOT parent was found, and releases must not depend on unreleased artifacts. Replace it with a released version; see 'sh mvnw dependency:tree'.</message>
                                        </requireReleaseDeps>
                                        <requireNoRepositories>
                                            <banRepositories>true</banRepositories>
                                            <banPluginRepositories>true</banPluginRepositories>
                                            <message>Maven Central rejects POMs that declare custom repositories or pluginRepositories (the project or its parents). Remove them: every dependency and plugin must be available from Maven Central.</message>
                                        </requireNoRepositories>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central-publishing-maven-plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>maven-central</publishingServerId>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
